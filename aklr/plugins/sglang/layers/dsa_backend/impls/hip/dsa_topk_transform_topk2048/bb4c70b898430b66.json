{
  "schema_version": 5,
  "name": "dsa_topk_transform_topk2048",
  "contract_id": "dsa_topk_transform@1.0",
  "description": "sglang's DSA indexer top-k on HIP (sgl_kernel.fast_topk_transform_fused): each row selects the topk highest of its first lengths scores and writes their slots in the page_size=1 page table of its sequence, the cu_seqlens_q range holding the row; a row of at most topk scores writes all of its slots in order, then -1.",
  "op_type": "dsa_backend",
  "axes": {
    "n_tokens": {
      "type": "var",
      "description": "Rows, one per token."
    },
    "n_candidates": {
      "type": "var",
      "description": "Scores per row."
    },
    "n_seqs": {
      "type": "var",
      "description": "Sequences."
    },
    "n_starts": {
      "type": "var",
      "description": "Sequence boundaries: n_seqs + 1."
    },
    "n_slots": {
      "type": "var",
      "description": "Page table columns."
    },
    "topk": {
      "type": "const",
      "value": 2048,
      "description": "Slots per row, 2048: all sglang's kernel takes."
    }
  },
  "attrs": {},
  "inputs": {
    "score": {
      "shape": [
        "n_tokens",
        "n_candidates"
      ],
      "dtype": "float32",
      "distribution": {
        "kind": "permutation"
      },
      "description": "Candidate scores per row."
    },
    "lengths": {
      "shape": [
        "n_tokens"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": 0,
        "hi": "min(n_candidates, n_slots)",
        "distinct": false
      },
      "description": "Valid candidates per row, a prefix its page table covers."
    },
    "page_table_size_1": {
      "shape": [
        "n_seqs",
        "n_slots"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": 0,
        "hi": "n_slots - 1",
        "distinct": true
      },
      "description": "Each sequence's slot of each candidate position, distinct within a row."
    },
    "cu_seqlens_q": {
      "shape": [
        "n_starts"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "cu_seqlens",
        "min_seqlen": 1,
        "total": "n_tokens"
      },
      "description": "Each sequence's first row, then n_tokens."
    }
  },
  "outputs": {
    "out_page_indices": {
      "shape": [
        "n_tokens",
        "topk"
      ],
      "dtype": "int32",
      "description": "Selected slots; -1 after a short row's entries."
    }
  },
